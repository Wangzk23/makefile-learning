.PHONY: all

foo = defined

ifdef foo
	result1 = "foo is defined"
endif

ifndef bar
	result2 = "bar is not defined"
endif

sharp = square
desk = square
table = circle

ifeq ($(sharp), $(desk))
	result3 = "desk == sharp"
endif

ifneq "$(sharp)" "$(table)"
	result4 = "table != sharp"
endif

all:
	@echo $(result1)
	@echo $(result2)
	@echo $(result3)
	@echo $(result4)
